{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1280px"
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingScale": { "steps": 7 }
    },
    "color": {
      "palette": [
        { "slug": "text-primary", "color": "#191B23", "name": "Primary text" },
        { "slug": "text-secondary", "color": "#434655", "name": "Secondary text" },
        { "slug": "text-muted", "color": "#6B7280", "name": "Muted text" },
        { "slug": "accent", "color": "#004AC6", "name": "Accent" },
        { "slug": "accent-hover", "color": "#495C95", "name": "Accent hover" },
        { "slug": "background", "color": "#F9F9F9", "name": "Background" },
        { "slug": "background-tint", "color": "#F3F3FE", "name": "Tinted background" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Surface" },
        { "slug": "border", "color": "#D9D9E5", "name": "Border" },
        { "slug": "success", "color": "#16A34A", "name": "Success / in-stock" },
        { "slug": "error", "color": "#BA1A1A", "name": "Error / destructive" },
        { "slug": "error-background", "color": "#FFF8F6", "name": "Error background" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Space Grotesk",
          "fontFamily": "\"Space Grotesk\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/space-grotesk-regular.woff2"]
            },
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/space-grotesk-bold.woff2"]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "Inter, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-regular.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-medium.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-semibold.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/inter-bold.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "2xs", "size": "10px", "name": "2X Small" },
        { "slug": "xs", "size": "12px", "name": "X Small" },
        { "slug": "small", "size": "14px", "name": "Small" },
        { "slug": "medium", "size": "16px", "name": "Medium" },
        { "slug": "large", "size": "18px", "name": "Large" },
        { "slug": "x-large", "size": "24px", "name": "X Large" },
        { "slug": "2x-large", "size": "32px", "name": "2X Large" },
        { "slug": "3x-large", "size": "40px", "name": "3X Large" },
        { "slug": "4x-large", "size": "48px", "name": "4X Large" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-hover)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--surface)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-hover)",
             "text": "var(--wp--preset--color--surface)"
          }
        }
      }
    }
  },
 "customTemplates": [],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "checkout-header", "title": "Checkout Header", "area": "uncategorized" }
  ]
}
